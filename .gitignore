# ==========================================
# AnyReel Creative - Git Ignore Rules
# ==========================================

# 1. Environment & Sensitive Privacy Files (File Privasi & Kredensial)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
!.env.example
!.env.*.example
!client/.env.example
!server/.env.example

# Kredensial, Kunci Rahasia, Sertifikat & Token
*.pem
*.key
*.crt
*.cer
*.pfx
*.p12
*.pub
id_rsa
id_ecdsa
id_ed25519
secrets.json
credentials.json
serviceAccountKey*.json
firebase-adminsdk*.json

# 2. Dependencies (Node.js)
node_modules/
**/node_modules/
jspm_packages/

# 3. Build & Production Outputs
dist/
**/dist/
dist-ssr/
build/
**/build/
out/
.next/
*.tsbuildinfo

# 4. Logs & Debugging
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. Database, Local Storage & Backups (Privasi Data Pengguna & Transaksi)
*.sqlite
*.sqlite3
*.db
*.db-journal
*.sql.dump
*.dump
*.bak
*.backup
dump.rdb

# 6. Uploads & Temporary Media / Storage
uploads/
**/uploads/
storage/
**/storage/
temp/
**/temp/
tmp/
**/tmp/
*.tmp

# 7. OS & System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# 8. Editor & IDE Settings
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 9. Deployment & Cloud Caches
.vercel/
.turbo/
.cache/
.parcel-cache/
.serverless/

# 10. Testing & Coverage
coverage/
**/coverage/
.nyc_output/
